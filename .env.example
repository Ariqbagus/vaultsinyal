# Copy to .env and fill in. NEVER commit .env.
# Developer key from the Terminal 3 claim page (shown once). The official
# docs call this T3N_API_KEY; VaultSinyal reads T3_API_KEY first and falls
# back to T3N_API_KEY, so either name works.
T3_API_KEY=
# T3N_API_KEY=

# testnet | production (this project targets testnet)
T3N_ENV=testnet

# Filled in by `npm run setup` output (org/agent creation is NOT idempotent,
# so these are persisted in env, exactly like the official walkthrough):
ORG_DID=
AGENT_DID=
# The agent's own API key, shown ONCE at creation. Store it encrypted.
AGENT_API_KEY=
# DID of the customer whose record the agent checks (your own DID for the
# single-user flow; another user's DID once they grant the agent `check`).
CUSTOMER_DID=

# Contract identity (defaults match contract/ in this repo)
CONTRACT_TAIL=signal-vault
CONTRACT_VERSION=0.1.0
WASM_PATH=../contract/target/wasm32-wasip2/release/signal_vault.wasm
